<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:name=".WorkHoursApplication"
        android:allowBackup="true"
        android:label="上班总时间"
        android:theme="@style/AppTheme">

        <activity
            android:name=".WageActivity"
            android:exported="false"
            android:label="工资统计" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="上班总时间" />

        <activity-alias
            android:name=".WorkHoursLauncher"
            android:enabled="true"
            android:exported="true"
            android:label="上班总时间"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".WageLauncher"
            android:enabled="true"
            android:exported="true"
            android:label="工资统计"
            android:targetActivity=".WageActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>
</manifest>
